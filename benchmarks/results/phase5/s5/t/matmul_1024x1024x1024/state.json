            "effect": "ignored:wmma_tile",
            "rationale": {
              "text": "Symmetric WM=4,WN=4,WTM=2,WTN=2 \u2014 perfectly balanced block and warp tiles for a square 1024x1024 matmul. Equal M/N tiling avoids asymmetric memory access patterns and may produce the best cache line alignment for both A and B.",
              "lang": "en"
            }
          },
          {
            "source_kind": "pipeline_stages",
            "source_step": 2,
            "effect": "ignored:pipeline_stages",
            "rationale": {
              "text": "Software pipelining depth=2 enables double-buffering in shared memory: while one tile is being computed by the WMMA units, the next tile is being prefetched. This effectively hides global\u2192shared memory latency, which is critical on Ampere where async copy instructions (cp.async) are available.",
              "lang": "en"
            }
          }
        ]
      },
