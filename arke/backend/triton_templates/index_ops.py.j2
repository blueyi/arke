    mask = mask_row[:, None] & mask_d[None, :]
    vals = tl.load(table_ptrs, mask=mask, other=0.0)

    # Store to output
    out_ptrs = Out_ptr + offs_row[:, None] * stride_out_row + offs_d[None, :] * stride_out_d
    tl.store(out_ptrs, vals, mask=mask)


