"""Auto-generated Triton {{ norm_type }} kernel by Arke.

slim-launch 2026-07-26 — launch-overhead pass (embedding d35bb62 pattern):
layernorm is launch-overhead bound on benchmark shapes (AK CPU dispatch
measured flat ~38-42µs across NORM_SHAPES, see skill
arke-benchmark-harness/references/launch-overhead-op-optimization.md).
  1. Contiguous fast-path kernel derives row stride as row*N — drops M and
     all 4 stride args (11 launch args → 7).
  2. Per-N launch-config cache (module dict): next_power_of_2 + num_warps
     ladder computed once per distinct N, not per call.
Non-contiguous inputs keep the general strided kernel.
"""
import torch
import triton
import triton.language as tl


@triton.jit
def {{ kernel_name }}_c_kernel(
    X_ptr, Y_ptr, W_ptr, B_ptr,
    N,
    eps: tl.constexpr,
    BLOCK_N: tl.constexpr,
    HAS_BIAS: tl.constexpr,
):
    row = tl.program_id(0)
    offs_n = tl.arange(0, BLOCK_N)
    mask = offs_n < N

    x = tl.load(X_ptr + row * N + offs_n, mask=mask, other=0.0).to(tl.float32)
    w = tl.load(W_ptr + offs_n, mask=mask, other=1.0).to(tl.float32)

    {% if norm_type == "layernorm" %}
    mean = tl.sum(x, axis=0) / N
    x_centered = x - mean
    var = tl.sum(x_centered * x_centered, axis=0) / N
    x_norm = x_centered / tl.sqrt(var + eps)
    {% else %}
    rms = tl.sum(x * x, axis=0) / N
    x_norm = x / tl.sqrt(rms + eps)
    {% endif %}

    y = x_norm * w
    if HAS_BIAS:
        b = tl.load(B_ptr + offs_n, mask=mask, other=0.0).to(tl.float32)
        y = y + b

    tl.store(Y_ptr + row * N + offs_n, y.to(tl.float16), mask=mask)


@triton.jit
def {{ kernel_name }}_kernel(
    X_ptr, Y_ptr, W_ptr, B_ptr,
    M, N,
    stride_xm, stride_xn,
    stride_ym, stride_yn,
    eps: tl.constexpr,
    BLOCK_N: tl.constexpr,
    HAS_BIAS: tl.constexpr,
):
    row = tl.program_id(0)
    offs_n = tl.arange(0, BLOCK_N)
    mask = offs_n < N

    x_ptrs = X_ptr + row * stride_xm + offs_n * stride_xn
    x = tl.load(x_ptrs, mask=mask, other=0.0).to(tl.float32)
    w = tl.load(W_ptr + offs_n, mask=mask, other=1.0).to(tl.float32)

    {% if norm_type == "layernorm" %}
    # LayerNorm: y = (x - mean) / sqrt(var + eps) * w + b
    mean = tl.sum(x, axis=0) / N
    x_centered = x - mean
    var = tl.sum(x_centered * x_centered, axis=0) / N
    x_norm = x_centered / tl.sqrt(var + eps)
    {% else %}
    # RMSNorm: y = x / sqrt(mean(x^2) + eps) * w
    rms = tl.sum(x * x, axis=0) / N
    x_norm = x / tl.sqrt(rms + eps)
    {% endif %}

    y = x_norm * w
    if HAS_BIAS:
        b = tl.load(B_ptr + offs_n, mask=mask, other=0.0).to(tl.float32)
        y = y + b

    y_ptrs = Y_ptr + row * stride_ym + offs_n * stride_yn
    tl.store(y_ptrs, y.to(tl.float16), mask=mask)


# Cached dummy bias (avoids allocation per call)
_dummy_bias: torch.Tensor | None = None

# Per-N launch-config cache: N -> (BLOCK_N, num_warps).
_LAUNCH_CFG: dict = {}


def _norm_cfg(N: int):
    BLOCK_N = triton.next_power_of_2(N)
    if BLOCK_N > 65536:
        # Single-pass kernel cannot cover the row: fail loudly instead of
        # silently truncating the reduction (found 2026-07-26 in the
        # reduce-family tier-3 sweep; norm shapes cap at N=14336 so no
        # benchmark path hits this — guard is for correctness safety).
        raise ValueError(
            f"{{ kernel_name }}: N={N} exceeds single-pass BLOCK_N limit 65536; "
            "a tiled loop variant is required for this row width"
        )
    num_warps = 2 if BLOCK_N <= 256 else (4 if BLOCK_N <= 2048 else (8 if BLOCK_N <= 8192 else 16))
    cfg = (BLOCK_N, num_warps)
    _LAUNCH_CFG[N] = cfg
    return cfg


def {{ kernel_name }}(
    X: torch.Tensor,
    weight: torch.Tensor,
    bias: torch.Tensor | None = None,
    eps: float = 1e-5,
) -> torch.Tensor:
    global _dummy_bias
    M, N = X.shape
    Y = torch.empty_like(X)
    cfg = _LAUNCH_CFG.get(N)
    if cfg is None:
        cfg = _norm_cfg(N)
    BLOCK_N, num_warps = cfg
    has_bias = bias is not None
    if not has_bias:
        if _dummy_bias is None or _dummy_bias.device != X.device:
            _dummy_bias = torch.zeros(1, device=X.device, dtype=X.dtype)
        bias = _dummy_bias
    # Contiguous fast path: X and Y (empty_like of contiguous X) have strides
    # exactly (N, 1) — derive offsets inside the kernel; weight/bias are 1-D.
    if X.is_contiguous():
        {{ kernel_name }}_c_kernel[(M,)](
            X, Y, weight, bias,
            N,
            eps=eps,
            BLOCK_N=BLOCK_N,
            HAS_BIAS=has_bias,
            num_warps=num_warps,
        )
        return Y
    {{ kernel_name }}_kernel[(M,)](
        X, Y, weight, bias,
        M, N,
        X.stride(0), X.stride(1),
        Y.stride(0), Y.stride(1),
        eps=eps,
        BLOCK_N=BLOCK_N,
        HAS_BIAS=has_bias,
        num_warps=num_warps,
    )
    return Y


def {{ kernel_name }}_warmup_buckets(hidden_dims, device="cuda", dtype=torch.float16):
    """Pre-compile the {{ norm_type }} kernel for each feature-dim (N) bucket.

    R3 follow-up (audit 2026-07-30): row-scan norms share the dynamic-shape
    cliff (first-touch JIT compile per specialization). Unlike rmsnorm, the
    layernorm contiguous fast-path (`_c_kernel`) derives the row stride as
    ``row*N`` and therefore does NOT take M as a runtime specialization arg —
    the only Triton specialization keys are the ``BLOCK_N`` constexpr
    (=next_pow2(N)) and ``HAS_BIAS``. So warming each model N once for both
    bias variants removes the cliff entirely (no residual M-class recompile,
    which is why this is simpler than the rmsnorm warmup). Pass the model's
    hidden dim(s). Returns the set of warmed N.
    """
    warmed = set()
    for N in hidden_dims:
        Ni = int(N)
        if Ni <= 0 or Ni in warmed:
            continue
        warmed.add(Ni)
        wgt = torch.ones((Ni,), device=device, dtype=dtype)
        X = torch.empty((16, Ni), device=device, dtype=dtype)
        # Warm both HAS_BIAS branches (each is a distinct specialization).
        {{ kernel_name }}(X, wgt)
        {% if norm_type == "layernorm" %}
        bias = torch.zeros((Ni,), device=device, dtype=dtype)
        {{ kernel_name }}(X, wgt, bias)
        {% endif %}
    if device == "cuda" and torch.cuda.is_available():
        torch.cuda.synchronize()
    return warmed
