"""Auto-generated Triton matmul kernel by Arke.

slim-launch 2026-07-26 — launch-overhead pass (embedding d35bb62 pattern):
small matmul shapes are launch-bound (AK CPU dispatch ~56-64µs flat, of which
the Triton autotuner key-lookup + 6 stride args are pure host overhead).
  1. Contiguous fast-path kernel derives strides from (M, N, K) in-kernel —
     12 launch args → 6. Non-contiguous inputs keep the general kernel.
  2. Both kernels share the same autotune config ladder (perf-critical tile
     choices unchanged).

K-H3.1 bucketed launcher-side cache (2026-07-28) — mitigate the "autotune
cliff": Triton's ``@triton.autotune(key=[M, N, K])`` treats every new
(M, N, K) triple as a cache miss and re-scans the full config ladder on
first call (measured 10-13 s cold cost on RTX 3060, see
``benchmarks/probes/autotune_first_call.py``). FlagGems, Liger, and the
Triton tutorial all sidestep this by keying on ``(next_pow2(M),
next_pow2(N), next_pow2(K))`` so neighbouring shapes share tuned configs.

We take the **launcher-side cache** route (identical pattern to
``batch_matmul.py.j2::_bmm_cfg`` and ``grouped_matmul.py.j2``):
  - Drop ``@triton.autotune`` entirely (which forces the tuning key to be
    a *kernel* runtime arg — extra launch args = launch-overhead
    regression on tiny shapes).
  - Compute the bucket triple in the python launcher, look up a small
    module-level dict of picked configs, cold-scan the ladder only on
    bucket miss.
  - Kernel launch args stay at 6 (contiguous) / 12 (strided) — slim-launch
    preserved. First-call cost for a new bucket is one bench sweep;
    subsequent shapes in the same bucket are pure launcher lookup + launch.
"""
import torch
import triton
import triton.language as tl


def _next_pow2(x: int) -> int:
    """Ceil to the next power of two (autotune-key bucketing, K-H3.1).

    Values ≤ 1 collapse to 1. Small dims (≤16) collapse to their exact value
    so pathological small tests keep a stable, non-explosive key domain.
    """
    if x <= 1:
        return 1
    if x <= 16:
        # Preserve exact key for tiny dims (correctness tests, unit shapes).
        return x
    # Standard next-power-of-two via bit trick, safe for 32-bit int.
    return 1 << (x - 1).bit_length()


_MM_CONFIGS = [
    # Small shapes (M≤256): low tile, high occupancy
    {"BLOCK_M": 16, "BLOCK_N": 16, "BLOCK_K": 64, "GROUP_SIZE_M": 8, "num_stages": 5, "num_warps": 2},
    {"BLOCK_M": 16, "BLOCK_N": 32, "BLOCK_K": 64, "GROUP_SIZE_M": 8, "num_stages": 5, "num_warps": 2},
    {"BLOCK_M": 32, "BLOCK_N": 16, "BLOCK_K": 64, "GROUP_SIZE_M": 8, "num_stages": 5, "num_warps": 2},
    {"BLOCK_M": 16, "BLOCK_N": 64, "BLOCK_K": 64, "GROUP_SIZE_M": 8, "num_stages": 4, "num_warps": 4},
    {"BLOCK_M": 64, "BLOCK_N": 16, "BLOCK_K": 64, "GROUP_SIZE_M": 8, "num_stages": 4, "num_warps": 4},
    # Medium shapes
    {"BLOCK_M": 32, "BLOCK_N": 32, "BLOCK_K": 32, "GROUP_SIZE_M": 8, "num_stages": 4, "num_warps": 4},
    {"BLOCK_M": 64, "BLOCK_N": 32, "BLOCK_K": 32, "GROUP_SIZE_M": 8, "num_stages": 4, "num_warps": 4},
