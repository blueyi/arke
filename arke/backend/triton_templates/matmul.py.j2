    {% if fused_activation == "relu" %}
    acc = tl.maximum(acc, 0.0)
    {% elif fused_activation == "gelu" %}
    acc = acc * 0.5 * (1.0 + tl.math.erf(acc / tl.math.sqrt(2.0)))
