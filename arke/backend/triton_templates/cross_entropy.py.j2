"""Auto-generated Triton cross entropy kernel by Arke.

Handles: cross_entropy, fused_linear_cross_entropy
Template variable `fused_linear` (bool) controls the variant.

cross_entropy: logits[M, V] + labels[M] → loss[M]
fused_linear_cross_entropy: hidden[M, D] @ weight[V, D]^T → logits → CE loss

Uses online softmax (numerically stable): log_softmax then nll.
"""
import torch
import triton
import triton.language as tl


{% if fused_linear %}
@triton.jit
def {{ kernel_name }}_ce_kernel(
    Logits_ptr, Labels_ptr, Loss_ptr,
    n_rows, V,
    stride_lm, stride_lv,
    BLOCK_V: tl.constexpr,
):
    """Per-row CE over a materialized logits chunk: loss[m] = -log_softmax(logits[m])[label[m]].

    1D online-softmax over the vocabulary dimension. The chunk's logits are
    produced by a real GEMM (torch.matmul) in the launcher, so this kernel only
    does the cheap row-wise reduction — no hand-rolled matmul, no 2D weight tile,
    no Triton numel-limit hazard.
    """
    pid_m = tl.program_id(0)
    if pid_m >= n_rows:
        return

    label = tl.load(Labels_ptr + pid_m)

    max_logit = float("-inf")
    sum_exp = 0.0
    target_logit = 0.0

    for v_start in range(0, V, BLOCK_V):
        offs_v = v_start + tl.arange(0, BLOCK_V)
        mask_v = offs_v < V
        logits = tl.load(
            Logits_ptr + pid_m * stride_lm + offs_v * stride_lv,
            mask=mask_v,
            other=float("-inf"),
        ).to(tl.float32)

        is_target = offs_v == label
        target_logit += tl.sum(tl.where(is_target, logits, 0.0))

        chunk_max = tl.max(logits)
        new_max = tl.maximum(max_logit, chunk_max)
        sum_exp = sum_exp * tl.exp(max_logit - new_max) + tl.sum(
            tl.where(mask_v, tl.exp(logits - new_max), 0.0)
        )
        max_logit = new_max

    loss = -target_logit + max_logit + tl.log(sum_exp)
    tl.store(Loss_ptr + pid_m, loss)


def {{ kernel_name }}(
    hidden: torch.Tensor, weight: torch.Tensor, labels: torch.Tensor,
    reduction: str = "mean",
) -> torch.Tensor:
    """Fused linear + cross entropy.

    Args:
        hidden: [M, D]
        weight: [V, D]
        labels: [M] (int64)
        reduction: "mean" (default, scalar — matches the op schema and
            F.cross_entropy default), "sum" (scalar), or "none" (per-token
            [M], used by the L2 fusion path that consumes per-row loss).

    Returns:
        loss: scalar () for "mean"/"sum", or [M] for "none".

    Design (Liger chunked FLCE): the logits = hidden @ weight.T are produced by
    a REAL GEMM (torch.matmul → cuBLAS, or the FlagGems-hijacked Triton GEMM
    when flag_gems.enable() is active) instead of a hand-rolled row-parallel
    matmul. A 1D per-row CE Triton kernel then reduces each materialized row.
    To bound the materialized BT x V activation memory, M is processed in
    chunks sized so each chunk's logits matrix stays within budget — exactly
    the Liger inc_factor / chunk_size recipe. This replaces the previous
    grid=(M,) kernel that serially recomputed the full GEMM per row (correct
    but ~250x slower than eager on large vocab).
    """
    M, D = hidden.shape
    V = weight.shape[0]
    loss = torch.empty(M, device=hidden.device, dtype=torch.float32)

    # 1D CE block over V — pure load, no 2D tile, so no numel hazard.
    BLOCK_V = min(triton.next_power_of_2(V), 16384)
    BLOCK_V = max(BLOCK_V, 1)

    # Chunk over M so the materialized chunk logits (chunk_size x V) stay
    # within a memory budget. inc_factor ~ V/D gives Liger's activation-parity
    # chunk; we then GROW chunk_size up to a budget cap so small-V shapes don't
    # pay per-chunk launch overhead across many tiny chunks (e.g. gpt2 V=50257
    # would otherwise be chunk_size=2 x 64 chunks = 64 matmul+CE launches).
    # next_power_of_2 keeps GEMM dims clean. Bound to [1, M].
    _CHUNK_LOGITS_BUDGET = 128 * 1024 * 1024  # 128 MiB of fp16 logits per chunk
    inc_factor = max((V + D - 1) // D, 1)
    chunk_parity = max((M + inc_factor - 1) // inc_factor, 1)
    chunk_budget = max(_CHUNK_LOGITS_BUDGET // (V * 2), 1)  # rows that fit in budget
    chunk_size = triton.next_power_of_2(max(chunk_parity, chunk_budget))
    chunk_size = max(min(chunk_size, M), 1)

    for start in range(0, M, chunk_size):
        end = min(start + chunk_size, M)
        hidden_chunk = hidden[start:end]                 # [c, D]
        labels_chunk = labels[start:end].contiguous()    # [c]
        # Real GEMM in the tensors' native precision (matches F.cross_entropy
        # which upcasts internally; we accumulate CE in fp32 in the kernel).
        logits_chunk = (hidden_chunk @ weight.t()).contiguous()  # [c, V]
        n_rows = logits_chunk.shape[0]
        {{ kernel_name }}_ce_kernel[(n_rows,)](
            logits_chunk, labels_chunk, loss[start:end],
            n_rows, V,
            logits_chunk.stride(0), logits_chunk.stride(1),
            BLOCK_V=BLOCK_V,
        )

    if reduction == "mean":
        return loss.mean()
    if reduction == "sum":
        return loss.sum()
    return loss


{% else %}
@triton.jit
def {{ kernel_name }}_kernel(
    Logits_ptr, Labels_ptr, Loss_ptr,
    M, V,
    stride_lm, stride_lv,
    BLOCK_V: tl.constexpr,
):
    """Cross entropy: loss[m] = -log_softmax(logits[m])[label[m]]."""
    pid_m = tl.program_id(0)
    if pid_m >= M:
        return

    label = tl.load(Labels_ptr + pid_m)

    # Online softmax over vocabulary dimension
    max_logit = float("-inf")
    sum_exp = 0.0
    target_logit = 0.0

    for v_start in range(0, V, BLOCK_V):
        offs_v = v_start + tl.arange(0, BLOCK_V)
        mask_v = offs_v < V

        logits = tl.load(
            Logits_ptr + pid_m * stride_lm + offs_v * stride_lv,
            mask=mask_v,
            other=float("-inf"),
        ).to(tl.float32)

        # Track target logit
        is_target = offs_v == label
        target_logit += tl.sum(tl.where(is_target, logits, 0.0))

        # Online softmax
        chunk_max = tl.max(logits)
        new_max = tl.maximum(max_logit, chunk_max)
        sum_exp = sum_exp * tl.exp(max_logit - new_max) + tl.sum(
            tl.where(mask_v, tl.exp(logits - new_max), 0.0)
        )
        max_logit = new_max

    loss = -target_logit + max_logit + tl.log(sum_exp)
    tl.store(Loss_ptr + pid_m, loss)


def {{ kernel_name }}(
    logits: torch.Tensor, labels: torch.Tensor, reduction: str = "mean"
) -> torch.Tensor:
    """Cross entropy loss.

    Args:
        logits: [M, V]
        labels: [M] (int64)
        reduction: "mean" (default, scalar — matches the op schema and
            F.cross_entropy default), "sum" (scalar), or "none" (per-token
            [M], used by the L2 fusion path that consumes per-row loss).

    Returns:
        loss: scalar () for "mean"/"sum", or [M] for "none".
    """
    M, V = logits.shape
    loss = torch.empty(M, device=logits.device, dtype=torch.float32)

    # BLOCK_V=4096 is the stable sweet spot for the per-row online-softmax on
    # Ampere: larger blocks (16384/32768) spill registers for big V (e.g.
    # V=50257) and regress, while smaller blocks add loop overhead. Picking a
    # single static larger block traded batch512 for extreme-bs and back
    # (measurement-noise dominated) — left at 4096; true gains need autotune.
    BLOCK_V = min(triton.next_power_of_2(V), 4096)
    grid = (M,)

    {{ kernel_name }}_kernel[grid](
        logits, labels, loss,
        M, V,
        logits.stride(0), logits.stride(1),
        BLOCK_V=BLOCK_V,
    )
    if reduction == "mean":
        return loss.mean()
    if reduction == "sum":
        return loss.sum()
    return loss
{% endif %}
