"""Auto-generated Triton FlashAttention kernel by Arke.

Handles: flash_attention, grouped_query_attention, cross_attention
Template variables:
  - causal (bool): apply causal mask
  - gqa_groups (int): GQA group count (1=MHA, >1=GQA). KV heads = Q heads / gqa_groups

Standard FlashAttention-2 tiled algorithm:
  Q[B, H, N, D], K[B, Hkv, S, D], V[B, Hkv, S, D] → O[B, H, N, D]

Outer loop over Q blocks, inner loop over KV blocks.
"""
import torch
import triton
import triton.language as tl

{% set GQA_GROUPS = gqa_groups | default(1) %}

@triton.jit
def {{ kernel_name }}_kernel(
    Q_ptr, K_ptr, V_ptr, O_ptr,
    sm_scale,
    B, H, N, S, D,
    stride_qb, stride_qh, stride_qn, stride_qd,
    stride_kb, stride_kh, stride_ks, stride_kd,
    stride_vb, stride_vh, stride_vs, stride_vd,
    stride_ob, stride_oh, stride_on, stride_od,
    GQA_GROUPS: tl.constexpr,
    CAUSAL: tl.constexpr,
    BLOCK_N: tl.constexpr,
    BLOCK_S: tl.constexpr,
    BLOCK_D: tl.constexpr,
):
    """FlashAttention-2 forward pass."""
    pid_n = tl.program_id(0)   # query block index
    pid_bh = tl.program_id(1)  # batch * head index

    batch_id = pid_bh // H
    head_id = pid_bh % H
    kv_head_id = head_id // GQA_GROUPS

    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
    offs_d = tl.arange(0, BLOCK_D)

    # Load Q block: [BLOCK_N, D]
    q_ptrs = (Q_ptr
              + batch_id * stride_qb
              + head_id * stride_qh
              + offs_n[:, None] * stride_qn
              + offs_d[None, :] * stride_qd)
    q_mask = (offs_n[:, None] < N) & (offs_d[None, :] < D)
    # FA-v2: keep Q in fp16 — tl.dot(fp16, fp16, out fp32) maps to Tensor
    # Core HMMA on sm_86; loading fp32 forced the dot onto FFMA (no TC).
    q = tl.load(q_ptrs, mask=q_mask, other=0.0)

    # Accumulators
    m_i = tl.full((BLOCK_N,), float("-inf"), dtype=tl.float32)  # row max
    l_i = tl.zeros((BLOCK_N,), dtype=tl.float32)               # row sum
    o_acc = tl.zeros((BLOCK_N, BLOCK_D), dtype=tl.float32)      # output

    # Determine KV range
    if CAUSAL:
        kv_len = tl.minimum(S, (pid_n + 1) * BLOCK_N)
    else:
        kv_len = S

    # Inner loop over KV blocks
    for s_start in range(0, kv_len, BLOCK_S):
        offs_s = s_start + tl.arange(0, BLOCK_S)
        s_mask = offs_s < S

        # Load K block: [BLOCK_S, D]
        k_ptrs = (K_ptr
                  + batch_id * stride_kb
                  + kv_head_id * stride_kh
                  + offs_s[:, None] * stride_ks
                  + offs_d[None, :] * stride_kd)
        k = tl.load(k_ptrs, mask=s_mask[:, None] & (offs_d[None, :] < D), other=0.0)

        # S = Q @ K^T * sm_scale: [BLOCK_N, BLOCK_S]
        # fp16 x fp16 -> fp32 accumulate (Tensor Core path on sm_86).
        attn = tl.dot(q, tl.trans(k), out_dtype=tl.float32) * sm_scale

        # Causal mask
        if CAUSAL:
            causal_mask = offs_n[:, None] >= offs_s[None, :]
            attn = tl.where(causal_mask & s_mask[None, :], attn, float("-inf"))
        else:
            attn = tl.where(s_mask[None, :], attn, float("-inf"))

        # Online softmax update
        m_new = tl.maximum(m_i, tl.max(attn, axis=1))
        alpha = tl.exp(m_i - m_new)
        p = tl.exp(attn - m_new[:, None])

        l_i = l_i * alpha + tl.sum(p, axis=1)
        o_acc = o_acc * alpha[:, None]

        # Load V block: [BLOCK_S, D]
        v_ptrs = (V_ptr
                  + batch_id * stride_vb
                  + kv_head_id * stride_vh
                  + offs_s[:, None] * stride_vs
                  + offs_d[None, :] * stride_vd)
        v = tl.load(v_ptrs, mask=s_mask[:, None] & (offs_d[None, :] < D), other=0.0)

        # Accumulate: O += P @ V — cast P to fp16 for the TC dot; the running
        # o_acc stays fp32 (accuracy preserved by fp32 accumulation).
        o_acc += tl.dot(p.to(tl.float16), v, out_dtype=tl.float32)
        m_i = m_new

    # Normalize
    o_acc = o_acc / l_i[:, None]

    # Store output
    o_ptrs = (O_ptr
              + batch_id * stride_ob
              + head_id * stride_oh
              + offs_n[:, None] * stride_on
              + offs_d[None, :] * stride_od)
    o_mask = (offs_n[:, None] < N) & (offs_d[None, :] < D)
    tl.store(o_ptrs, o_acc.to(tl.float16), mask=o_mask)


def _next_pow2(x: int) -> int:
    """Smallest power of two >= x (linear below 17, matches matmul.py.j2)."""
    if x <= 1:
        return 1
    if x <= 16:
        return x
    return 1 << (x - 1).bit_length()


# Launcher-side bucketed config memo (K-H3.1 pattern, K-ATT FA-v1).
# Key: (next_pow2(N), D_pow2, causal). Values chosen from the fp16 offline
# sweep on RTX 3060 sm_86 (docs/kestrel/k-att-plan.md FA-v1); heuristic
# consumes BUCKET dims so every shape in a bucket gets an identical config
# and Triton's JIT cache is maximally reused.
_FA_CFG_CACHE: dict = {}


def _fa_cfg(Nb: int, Db: int, causal: bool, is_mha: bool = True) -> dict:
    """Deterministic tile/pipeline heuristic for flash-attention.

    Distilled from the FA-v1 offline sweep (2026-07-29, RTX 3060 sm_86,
    fp16, 8 shapes x 42 configs, all correctness-checked <=5e-3, 0 incorrect;
    benchmarks/probes/results/fa_v1_sweep_2026-07-29.csv) + FA-v4 micro-sweep
    (2026-07-30, benchmarks/probes/results/fa_v4_micro_2026-07-30.log):

    * D=64 (gpt2-class): the historical default 64x64/4w/2s is already
      Pareto-best across S=512..2048 (top-3 within noise) — keep it.
    * D=128 (llama/ds-class): BLOCK_S is the decisive tile lever (the 64-wide
      K/V tile blows up register/smem pressure and collapses occupancy — same
      lesson as the CUDA-C v8 BC 64->32 step).
      - MHA short-S (gqa_groups==1, S<2048): FA-v4 found the wide-Q/thin-K/V
        128/16/4w config lifts the bucket geomean 0.743 -> 0.854 (+15%;
        llama2-7b-512 0.645 -> 0.788). The FA-v1 grid under-explored BLOCK_N
        here.
      - GQA short-S (gqa_groups>1, S<2048): the SAME 128/16 config REGRESSES
        (llama3-8b-512 0.795 -> 0.721) because shared K/V heads flip the
        wide-Q/thin-K/V tradeoff — A/B verified 2026-07-30. GQA short-S is
        further bucket-split (FA-v6): Nb<=512 keeps FA-v1's 32/32, but Nb==1024
        wants 128/16 (enough Q rows to fill the wide tile). This is why the
        heuristic is MHA/GQA-aware AND Nb-bucketed.
      - S>=2048 (BOTH MHA and GQA): FA-v5 (2026-07-30 median-of-3 interleaved
        A/B) found FA-v1's 128x32/**8w** is markedly SUB-optimal — 8 warps at
        D=128 long-S over-pressure registers and collapse occupancy. Dropping
        to **4 warps** (128/16/4w) lifts both: MHA llama2-7b-2k 0.784->0.934,
        llama2-7b-4k 0.812->0.977, ds-v2-2k 0.801->0.962; GQA llama3-8b-2k
        0.734->0.879, qwen25-7b-2k 0.736->0.885. Same config wins MHA and GQA,
        so no is_mha split needed here (unlike short-S).
    * num_stages: 2 wins everywhere on sm_86; 3/4 never helped (Triton's
      pipeliner gains nothing past double-buffering here).

    Nb is the next_pow2 bucket of query length N; Db = BLOCK_D; is_mha is
    True when gqa_groups==1 (multi-head attention), False for GQA.
    """
    if Db >= 128:
        if Nb >= 2048:
            # FA-v5: long-S D=128 wants 4 warps, not FA-v1's 8 (occupancy);
            # single winner across MHA + GQA (median-of-3 A/B 2026-07-30).
            return {"BLOCK_N": 128, "BLOCK_S": 16, "num_warps": 4, "num_stages": 2}
        if is_mha:
            # FA-v4: MHA short-S D=128 wants wide-Q 128 + thin K/V 16.
            return {"BLOCK_N": 128, "BLOCK_S": 16, "num_warps": 4, "num_stages": 2}
        # GQA short-S D=128 is bucket-split (FA-v6, median-of-3 A/B 2026-07-30):
        #   Nb==1024: wide-Q 128/16 wins (llama3-8b-1k 0.697->0.835,
        #             qwen25-7b-1k 0.810->0.848) — enough Q rows to fill 128.
        #   Nb<=512:  32/32 still wins (llama3-8b-512 0.842 vs 128/16 0.754) —
        #             too few Q rows to amortize the wide tile.
        if Nb >= 1024:
            return {"BLOCK_N": 128, "BLOCK_S": 16, "num_warps": 4, "num_stages": 2}
        return {"BLOCK_N": 32, "BLOCK_S": 32, "num_warps": 4, "num_stages": 2}
    return {"BLOCK_N": 64, "BLOCK_S": 64, "num_warps": 4, "num_stages": 2}


def _cfg_from_schedule_tile(tile_factors, resources: dict | None = None) -> dict | None:
    """Narrow L2 real-driver seam (audit 2026-07-30 §A).

    Translate a ScheduleIR ``LoopNest.tile_factors`` (a positional ``[q_block,
    kv_block]`` list, the real IR shape) plus an optional ``ResourceBinding``
    dict (``{"warps":.., "num_stages":..}``) into this launcher's config dict,
    so an Agent/StrategyIR tile decision that flows through
    ``arke/compiler/lowering.py`` (which already emits ``loop.configure`` from
    ``tile_factors`` and ``resource.bind`` from resources) can drive REAL
    codegen instead of being re-derived by the ``_fa_cfg`` heuristic. This is
    the minimal proof that an L2 field reaches a production backend — the
    bounded StrategyIR "tile" action the AI-Native thesis says an Agent owns.

    tile_factors must supply at least [q_block, kv_block]; returns None when
    absent/under-specified (caller then falls back to ``_fa_cfg`` — fully
    backward compatible).
    """
    if not tile_factors or len(tile_factors) < 2:
        return None
    res = resources or {}
    return {
        "BLOCK_N": int(tile_factors[0]),
        "BLOCK_S": int(tile_factors[1]),
        "num_warps": int(res.get("warps") or 4),
        "num_stages": int(res.get("num_stages") or 2),
    }


def {{ kernel_name }}(
    Q: torch.Tensor, K: torch.Tensor, V: torch.Tensor,
    _cfg_override: dict | None = None,
) -> torch.Tensor:
    """FlashAttention-2 forward.

    Args:
        Q: [B, H, N, D]
        K: [B, Hkv, S, D]
        V: [B, Hkv, S, D]

    Returns:
        O: [B, H, N, D]
    """
    B, H, N, D = Q.shape
    _, Hkv, S, _ = K.shape

    assert D <= 128, "head_dim > 128 not supported"
    # GQA-v1: derive groups from the actual tensor shapes at runtime instead
    # of trusting the render-time default. The render-time gqa_groups=4 was
    # silently WRONG for any model with Hq/Hkv != 4 (e.g. qwen2.5: 28/4 = 7
    # groups -> garbage output, err ~5.0). H % Hkv must divide cleanly.
    assert H % Hkv == 0, f"Hq={H} not divisible by Hkv={Hkv}"
    gqa_groups = H // Hkv
    O = torch.empty_like(Q)

    sm_scale = 1.0 / (D ** 0.5)

    BLOCK_D = triton.next_power_of_2(D)
    if _cfg_override is not None:
        cfg = _cfg_override
    else:
        # FA-v4: the tile winner differs between MHA (gqa_groups==1) and GQA
        # (shared K/V heads change the wide-Q/thin-K/V tradeoff), so groups is
        # part of the bucket key and drives the heuristic.
        is_mha = gqa_groups == 1
        bucket_key = (_next_pow2(N), BLOCK_D, {{ "True" if causal else "False" }}, is_mha)
        cfg = _FA_CFG_CACHE.get(bucket_key)
        if cfg is None:
            cfg = _fa_cfg(bucket_key[0], BLOCK_D, bucket_key[2], is_mha)
            _FA_CFG_CACHE[bucket_key] = cfg

    grid = (triton.cdiv(N, cfg["BLOCK_N"]), B * H)

    {{ kernel_name }}_kernel[grid](
        Q, K, V, O,
        sm_scale,
        B, H, N, S, D,
        Q.stride(0), Q.stride(1), Q.stride(2), Q.stride(3),
        K.stride(0), K.stride(1), K.stride(2), K.stride(3),
        V.stride(0), V.stride(1), V.stride(2), V.stride(3),
        O.stride(0), O.stride(1), O.stride(2), O.stride(3),
        GQA_GROUPS=gqa_groups,
        CAUSAL={{ "True" if causal else "False" }},
        BLOCK_N=cfg["BLOCK_N"], BLOCK_S=cfg["BLOCK_S"], BLOCK_D=BLOCK_D,
        num_warps=cfg["num_warps"], num_stages=cfg["num_stages"],
    )
    return O
