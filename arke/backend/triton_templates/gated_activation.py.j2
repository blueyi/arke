"""Auto-generated Triton gated activation kernel by Arke.

Handles: silu_and_mul, gelu_and_mul
Template variable `gate_activation` controls: "silu" (SwiGLU) or "gelu" (GeGLU).

Input X[M, 2N]: first N cols are gate, last N cols are value.
Output Y[M, N] = activation(gate) * value

Design: 1D-flattened element-wise launcher (FlagGems `pointwise_dynamic` /
glu.py style). The output Y has M*N elements; we tile that flat range so grid
occupancy saturates the SMs regardless of the M/N split. The old 2D
(cdiv(M,32), cdiv(N,1024)) grid under-occupied small shapes (e.g. gpt2-sm
M=128,N=3072 -> only ~12 CTAs on 30 SMs). Activation math in fp32 for
numerical stability; native output dtype (no hard-cast).
"""
import torch
import triton
import triton.language as tl


@triton.jit
def {{ kernel_name }}_kernel(
    X_ptr, Y_ptr,
    M, N, n_elements,
    stride_xm, stride_xn,
    stride_ym, stride_yn,
    BLOCK: tl.constexpr,
):
    """Gated activation over flattened Y index space.

    For flat output index e in [0, M*N): row = e // N, col = e % N.
    gate  = X[row, col]      value = X[row, col + N]
    Y[row, col] = act(gate) * value
    """
    pid = tl.program_id(0)
    offs = pid * BLOCK + tl.arange(0, BLOCK)
    mask = offs < n_elements

    row = offs // N
    col = offs % N

    gate_off = row * stride_xm + col * stride_xn
    val_off = row * stride_xm + (col + N) * stride_xn
    gate = tl.load(X_ptr + gate_off, mask=mask, other=0.0)
    val = tl.load(X_ptr + val_off, mask=mask, other=0.0)

    gate_f32 = gate.to(tl.float32)
    val_f32 = val.to(tl.float32)

    {% if gate_activation == "silu" %}
    # SwiGLU: silu(gate) * value = gate * sigmoid(gate) * value
    activated = gate_f32 * tl.sigmoid(gate_f32)
    {% elif gate_activation == "gelu" %}
    # GeGLU: gelu(gate) * value (erf form)
    activated = 0.5 * gate_f32 * (1.0 + tl.math.erf(gate_f32 * 0.7071067811865476))
    {% else %}
    activated = gate_f32
    {% endif %}

    y = (activated * val_f32).to(Y_ptr.dtype.element_ty)

    y_off = row * stride_ym + col * stride_yn
    tl.store(Y_ptr + y_off, y, mask=mask)


def {{ kernel_name }}(X: torch.Tensor) -> torch.Tensor:
    """Gated activation: X[M, 2N] -> Y[M, N].

    First N columns = gate, last N columns = value.
    """
    assert X.ndim == 2 and X.shape[1] % 2 == 0
    M = X.shape[0]
    N = X.shape[1] // 2
    Y = torch.empty((M, N), device=X.device, dtype=X.dtype)
    n_elements = M * N

    # Memory-bound element-wise: a large flat block + warps ladder saturates
    # bandwidth. 1024 elems/program with 4 warps is the FlagGems-style sweet
    # spot for fp16 on Ampere; bump warps for very large tiles.
    BLOCK = 1024
    num_warps = 4
    grid = (triton.cdiv(n_elements, BLOCK),)

    {{ kernel_name }}_kernel[grid](
        X, Y,
        M, N, n_elements,
        X.stride(0), X.stride(1),
        Y.stride(0), Y.stride(1),
        BLOCK=BLOCK,
        num_warps=num_warps,
    )
    return Y
