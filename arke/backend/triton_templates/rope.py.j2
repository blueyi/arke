"""Auto-generated Triton RoPE kernel by Arke.

Rotary Position Embedding (RoPE).
Spec (arke/ir/ops/catalog.py ROPE):
    X[B, H, S, D], cos[S, D/2], sin[S, D/2] -> Y[B, H, S, D]
    x1, x2 = X[..., :D/2], X[..., D/2:]
    Y = cat([x1*cos - x2*sin,  x2*cos + x1*sin], dim=-1)
cos/sin broadcast over (B, H): row (b, h, s) uses cos[s], sin[s].

Design ported from Liger-Kernel rope (PRIMARY). The previous Arke template was
DEAD: its launcher signature took scalar args (seq_len, n_heads) that the
tensor-only backend dispatcher can't supply, so the Triton path failed at call
time and rope silently fell back to the PyTorch interpreter (the "Arke" rope
PERF_ALL rows were eager, ~3x slower than Liger Triton — not a real kernel).

Key fixes:
  * Launcher takes ONLY tensors (X, cos, sin); all dims inferred from shapes.
  * One program per (b, h, s) row: load cos[s]/sin[s] once, rotate the D/2
    lanes in registers (Liger amortizes cos/sin load across the row instead of
    reloading per (row, hd) tile like the old 2D-grid Arke kernel).
  * fp32 rotation math, native output dtype.
"""
import torch
import triton
import triton.language as tl


@triton.jit
def {{ kernel_name }}_kernel(
    X_ptr, Cos_ptr, Sin_ptr, Y_ptr,
    S, half_dim,
    stride_x_row, stride_x_d,
    stride_cos_s, stride_cos_d,
    stride_y_row, stride_y_d,
    BLOCK_HD: tl.constexpr,
):
    """One program per flattened (b, h, s) row.

    Grid is (B*H*S,). Position s = row % S (rows are laid out
    [B, H, S] with S fastest-changing, so row % S recovers the seq index that
    cos/sin are indexed by — independent of b, h).
    """
    row = tl.program_id(0).to(tl.int64)
    pos = row % S

    offs_d = tl.arange(0, BLOCK_HD)
    mask_d = offs_d < half_dim

    cos = tl.load(Cos_ptr + pos * stride_cos_s + offs_d * stride_cos_d,
                  mask=mask_d, other=0.0).to(tl.float32)
    sin = tl.load(Sin_ptr + pos * stride_cos_s + offs_d * stride_cos_d,
                  mask=mask_d, other=0.0).to(tl.float32)

    x1_ptr = X_ptr + row * stride_x_row + offs_d * stride_x_d
    x2_ptr = X_ptr + row * stride_x_row + (offs_d + half_dim) * stride_x_d
    x1 = tl.load(x1_ptr, mask=mask_d, other=0.0).to(tl.float32)
    x2 = tl.load(x2_ptr, mask=mask_d, other=0.0).to(tl.float32)

    y1 = x1 * cos - x2 * sin
    y2 = x2 * cos + x1 * sin

    out_dtype = Y_ptr.dtype.element_ty
    y1_ptr = Y_ptr + row * stride_y_row + offs_d * stride_y_d
    y2_ptr = Y_ptr + row * stride_y_row + (offs_d + half_dim) * stride_y_d
    tl.store(y1_ptr, y1.to(out_dtype), mask=mask_d)
    tl.store(y2_ptr, y2.to(out_dtype), mask=mask_d)


def {{ kernel_name }}(X: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor) -> torch.Tensor:
    """Apply RoPE. X[B, H, S, D]; cos/sin [S, D/2]. Returns Y[B, H, S, D].

    Tensor-only signature (no scalar args) so the Arke Triton backend, which
    dispatches wrappers with positional tensor inputs in schema order, can call
    it directly instead of falling back to the interpreter.
    """
    assert X.ndim == 4, f"rope expects X[B,H,S,D], got {tuple(X.shape)}"
    B, H, S, D = X.shape
    half_dim = D // 2
    Y = torch.empty_like(X)

    # Flatten (B, H, S) -> rows; the row's D-dim is contiguous within the head.
    Xf = X.reshape(B * H * S, D)
    Yf = Y.reshape(B * H * S, D)
    n_rows = B * H * S

    BLOCK_HD = triton.next_power_of_2(half_dim)
    # Memory-bound: warps scale mildly with head width.
    num_warps = 4 if BLOCK_HD >= 64 else 2
    grid = (n_rows,)

    {{ kernel_name }}_kernel[grid](
        Xf, cos, sin, Yf,
        S, half_dim,
        Xf.stride(0), Xf.stride(1),
        cos.stride(0), cos.stride(1),
        Yf.stride(0), Yf.stride(1),
        BLOCK_HD=BLOCK_HD,
        num_warps=num_warps,
    )
    return Y
