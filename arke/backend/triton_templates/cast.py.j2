"""Auto-generated Triton cast kernel by Arke.

Tensor-only launcher: the backend dispatches kernels as `wrapper(*tensors)`,
so the target dtype cannot arrive as a runtime scalar argument. It is baked
into the template at codegen time via the `output_dtype` ctx variable
(derived from the node dtype by build_template_ctx). Launcher: cast(X) -> Y.
"""
import torch
import triton
import triton.language as tl


# Triton dtype -> torch dtype, used by the host wrapper to allocate Y.
_TL_TO_TORCH = {
    "tl.float16": torch.float16,
    "tl.bfloat16": torch.bfloat16,
    "tl.float32": torch.float32,
    "tl.int32": torch.int32,
    "tl.int64": torch.int64,
}


@triton.jit
def {{ kernel_name }}_kernel(
    X_ptr, Y_ptr,
    n_elements,
    BLOCK_SIZE: tl.constexpr,
):
    pid = tl.program_id(0)
    offsets = pid * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
    mask = offsets < n_elements
    x = tl.load(X_ptr + offsets, mask=mask)
    y = x.to({{ output_dtype }})
    tl.store(Y_ptr + offsets, y, mask=mask)


def {{ kernel_name }}(X: torch.Tensor) -> torch.Tensor:
    target_dtype = _TL_TO_TORCH["{{ output_dtype }}"]
    Y = torch.empty_like(X, dtype=target_dtype)
    n_elements = X.numel()
    if n_elements == 0:
        return Y
    if n_elements <= 65536:
        BLOCK_SIZE = 1024
        num_warps = 4
    elif n_elements <= 524288:
        BLOCK_SIZE = 4096
        num_warps = 4
    else:
        BLOCK_SIZE = 8192
        num_warps = 8
    grid = (triton.cdiv(n_elements, BLOCK_SIZE),)
    {{ kernel_name }}_kernel[grid](
        X, Y, n_elements, BLOCK_SIZE=BLOCK_SIZE, num_warps=num_warps,
    )
    return Y
