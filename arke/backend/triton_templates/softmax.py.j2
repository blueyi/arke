"""Auto-generated Triton softmax kernel by Arke.

S7.followup.4 — softmax L1 perf upgrade.
slim-launch 2026-07-26 — launch-overhead pass (embedding d35bb62 pattern).

Design (informed by FlagGems master 2b04dbd3 and Liger 7dc5417b):
  • dtype-aware: fp16/bf16 input → fp32 accumulate → cast back to input dtype
  • Two kernels split by N threshold (matches FlagGems softmax inner/non-inner split):
      N ≤ 16384 → single-pass online softmax (one row per program)
      N > 16384 → 3-pass online softmax with reversed pass-3 store +
                  eviction_policy="evict_first" for L2 cache reuse
  • num_warps ladder: 2 / 4 / 8 / 16 / 32 by BLOCK_N
  • int64 row index for large-M guard
  • Subtract-max trick (numerical stability) preserved in both paths

slim-launch (this op is launch-overhead bound on small shapes — AK CPU dispatch
measured flat ~34-40µs across an 8000× FLOP range, see
skill arke-benchmark-harness/references/launch-overhead-op-optimization.md):
  1. Contiguous fast-path kernels take (X, Y, N) and derive row strides as
     row*N inside the kernel — 8 launch args → 3. Every arg costs launcher
     overhead. Non-contiguous inputs keep the general strided kernels.
  2. Per-N launch-config cache (module dict): next_power_of_2 + num_warps
     ladder computed once per distinct N, not per call.

Refs:
  • FlagGems src/flag_gems/ops/softmax.py @ 2b04dbd3 (2026-06-18)
"""
import torch
import triton
import triton.language as tl


# ── slim single-pass kernel: contiguous rows, strides derived from N ─────────
@triton.jit
def {{ kernel_name }}_simple_c_kernel(
    X_ptr, Y_ptr,
    N,
    BLOCK_N: tl.constexpr,
):
    if tl.constexpr(X_ptr.dtype.element_ty == tl.float16) or tl.constexpr(
        X_ptr.dtype.element_ty == tl.bfloat16
    ):
        cdtype = tl.float32
    else:
        cdtype = X_ptr.dtype.element_ty
    out_dtype = X_ptr.dtype.element_ty

    row = tl.program_id(0).to(tl.int64)
    offs_n = tl.arange(0, BLOCK_N)
    mask = offs_n < N

    x = tl.load(X_ptr + row * N + offs_n, mask=mask, other=-float('inf')).to(cdtype)

    x_max = tl.max(x, axis=0)
    exp_x = tl.exp(x - x_max)
    sum_exp = tl.sum(exp_x, axis=0)
    y = (exp_x / sum_exp).to(out_dtype)

    tl.store(Y_ptr + row * N + offs_n, y, mask=mask)


# ── single-pass kernel (general strided): N <= 16384, one row per program ────
@triton.jit
def {{ kernel_name }}_simple_kernel(
    X_ptr, Y_ptr,
    M, N,
    stride_xm, stride_xn,
    stride_ym, stride_yn,
    BLOCK_N: tl.constexpr,
):
    if tl.constexpr(X_ptr.dtype.element_ty == tl.float16) or tl.constexpr(
        X_ptr.dtype.element_ty == tl.bfloat16
    ):
        cdtype = tl.float32
    else:
        cdtype = X_ptr.dtype.element_ty
    out_dtype = X_ptr.dtype.element_ty

    row = tl.program_id(0).to(tl.int64)
    offs_n = tl.arange(0, BLOCK_N)
    mask = offs_n < N

    x_ptrs = X_ptr + row * stride_xm + offs_n * stride_xn
    x = tl.load(x_ptrs, mask=mask, other=-float('inf')).to(cdtype)

    x_max = tl.max(x, axis=0)
    x_shifted = x - x_max
    exp_x = tl.exp(x_shifted)
    sum_exp = tl.sum(exp_x, axis=0)
    y = (exp_x / sum_exp).to(out_dtype)

    y_ptrs = Y_ptr + row * stride_ym + offs_n * stride_yn
    tl.store(y_ptrs, y, mask=mask)


# ── loop kernel: N > 16384, 3-pass online softmax (contiguous slim) ──────────
@triton.jit
def {{ kernel_name }}_loop_c_kernel(
    X_ptr, Y_ptr,
    N,
    TILE_N: tl.constexpr,
):
    if tl.constexpr(X_ptr.dtype.element_ty == tl.float16) or tl.constexpr(
        X_ptr.dtype.element_ty == tl.bfloat16
    ):
        cdtype = tl.float32
    else:
        cdtype = X_ptr.dtype.element_ty
    out_dtype = X_ptr.dtype.element_ty

    pid = tl.program_id(0).to(tl.int64)
    x_row_base = X_ptr + pid * N
    y_row_base = Y_ptr + pid * N

    # Pass 1: row max via tiled scan
    m_i = tl.full((TILE_N,), -float('inf'), dtype=tl.float32)
    num_steps = tl.cdiv(N, TILE_N)
    for step in range(0, num_steps - 1):
        start_n = step * TILE_N
        n_offsets = start_n + tl.arange(0, TILE_N)
        x = tl.load(x_row_base + n_offsets).to(tl.float32)
        m_i = tl.maximum(m_i, x)
    start_n = (num_steps - 1) * TILE_N
    n_offsets = start_n + tl.arange(0, TILE_N)
    mask = n_offsets < N
    x = tl.load(x_row_base + n_offsets, mask=mask, other=-float('inf')).to(tl.float32)
    m_i = tl.maximum(m_i, x)
    row_max = tl.max(m_i, axis=0)

    # Pass 2: sum of exp(x - row_max)
    s_i = tl.zeros((TILE_N,), dtype=tl.float32)
    for step in range(0, num_steps - 1):
        start_n = step * TILE_N
        n_offsets = start_n + tl.arange(0, TILE_N)
        x = tl.load(x_row_base + n_offsets).to(tl.float32)
        s_i += tl.exp(x - row_max)
    start_n = (num_steps - 1) * TILE_N
    n_offsets = start_n + tl.arange(0, TILE_N)
    mask = n_offsets < N
    x = tl.load(x_row_base + n_offsets, mask=mask, other=-float('inf')).to(tl.float32)
    s_i += tl.where(mask, tl.exp(x - row_max), 0.0)
    row_sum = tl.sum(s_i, axis=0)
    inv_sum = 1.0 / row_sum

    # Pass 3: write normalized exp, REVERSED order for L2 cache reuse
    prev_multiple = tl.cdiv(N, TILE_N) * TILE_N - TILE_N

    n_offsets = prev_multiple + tl.arange(0, TILE_N)
    mask = n_offsets < N
    x = tl.load(
        x_row_base + n_offsets,
        mask=mask,
        other=-float('inf'),
        eviction_policy="evict_first",
    ).to(cdtype)
    y = (tl.exp(x - row_max) * inv_sum).to(out_dtype)
    tl.store(y_row_base + n_offsets, y, mask=mask)

    for start_n in range(TILE_N, N, TILE_N):
        n_offsets = (prev_multiple - start_n) + tl.arange(0, TILE_N)
        x = tl.load(
            x_row_base + n_offsets,
            eviction_policy="evict_first",
        ).to(cdtype)
        y = (tl.exp(x - row_max) * inv_sum).to(out_dtype)
        tl.store(y_row_base + n_offsets, y)


# ── loop kernel (general strided): N > 16384, 3-pass online softmax ──────────
@triton.jit
def {{ kernel_name }}_loop_kernel(
    X_ptr, Y_ptr,
    M, N,
    stride_xm, stride_xn,
    stride_ym, stride_yn,
    TILE_N: tl.constexpr,
):
    if tl.constexpr(X_ptr.dtype.element_ty == tl.float16) or tl.constexpr(
        X_ptr.dtype.element_ty == tl.bfloat16
    ):
        cdtype = tl.float32
    else:
        cdtype = X_ptr.dtype.element_ty
    out_dtype = X_ptr.dtype.element_ty

    pid = tl.program_id(0).to(tl.int64)
    x_row_base = X_ptr + pid * stride_xm
    y_row_base = Y_ptr + pid * stride_ym

    # Pass 1: row max via tiled scan
    m_i = tl.full((TILE_N,), -float('inf'), dtype=tl.float32)
    num_steps = tl.cdiv(N, TILE_N)
    for step in range(0, num_steps - 1):
        start_n = step * TILE_N
        n_offsets = start_n + tl.arange(0, TILE_N)
        x = tl.load(x_row_base + n_offsets * stride_xn).to(tl.float32)
        m_i = tl.maximum(m_i, x)
    start_n = (num_steps - 1) * TILE_N
    n_offsets = start_n + tl.arange(0, TILE_N)
    mask = n_offsets < N
    x = tl.load(
        x_row_base + n_offsets * stride_xn, mask=mask, other=-float('inf')
    ).to(tl.float32)
    m_i = tl.maximum(m_i, x)
    row_max = tl.max(m_i, axis=0)

    # Pass 2: sum of exp(x - row_max)
    s_i = tl.zeros((TILE_N,), dtype=tl.float32)
    for step in range(0, num_steps - 1):
        start_n = step * TILE_N
        n_offsets = start_n + tl.arange(0, TILE_N)
        x = tl.load(x_row_base + n_offsets * stride_xn).to(tl.float32)
        s_i += tl.exp(x - row_max)
    start_n = (num_steps - 1) * TILE_N
    n_offsets = start_n + tl.arange(0, TILE_N)
    mask = n_offsets < N
    x = tl.load(
        x_row_base + n_offsets * stride_xn, mask=mask, other=-float('inf')
    ).to(tl.float32)
    s_i += tl.where(mask, tl.exp(x - row_max), 0.0)
    row_sum = tl.sum(s_i, axis=0)
    inv_sum = 1.0 / row_sum

    # Pass 3: write normalized exp, REVERSED order for L2 cache reuse
    # (last tile loaded in pass 2 is still hot)
    prev_multiple = tl.cdiv(N, TILE_N) * TILE_N - TILE_N

    # First reverse step: masked tail
    n_offsets = prev_multiple + tl.arange(0, TILE_N)
    mask = n_offsets < N
    x = tl.load(
        x_row_base + n_offsets * stride_xn,
        mask=mask,
        other=-float('inf'),
        eviction_policy="evict_first",
    ).to(cdtype)
    y = (tl.exp(x - row_max) * inv_sum).to(out_dtype)
    tl.store(y_row_base + n_offsets * stride_yn, y, mask=mask)

    # Remaining reverse steps (no mask)
    for start_n in range(TILE_N, N, TILE_N):
        n_offsets = (prev_multiple - start_n) + tl.arange(0, TILE_N)
        x = tl.load(
            x_row_base + n_offsets * stride_xn,
            eviction_policy="evict_first",
        ).to(cdtype)
        y = (tl.exp(x - row_max) * inv_sum).to(out_dtype)
        tl.store(y_row_base + n_offsets * stride_yn, y)


# Per-N launch-config cache: N -> (is_simple, BLOCK_or_TILE, num_warps).
# next_power_of_2 + the warp ladder are pure functions of N; computing them
# once per distinct N keeps the hot wrapper to dict-lookup + launch.
_LAUNCH_CFG: dict = {}


def _softmax_cfg(N: int):
    # Single-pass simple kernel loads each row from HBM exactly once. The
    # 3-pass loop kernel re-reads the row 3x, which only pays off when M is
    # large enough to saturate occupancy and hide the extra HBM traffic. For
    # low-M / moderate-N (e.g. attention logits M=32 N=8192, vocab M=1
    # N=50257) the single-pass kernel is ~1.3-1.8x faster than the loop
    # (measured RTX 3060). Threshold 16384 keeps these common LLM shapes on
    # the single-pass path; only genuinely huge rows fall to the loop kernel.
    if N <= 16384:
        BLOCK_N = triton.next_power_of_2(N)
        if BLOCK_N <= 256:
            num_warps = 2
        elif BLOCK_N <= 2048:
            num_warps = 4
        elif BLOCK_N <= 8192:
            num_warps = 8
        else:
            num_warps = 16
        cfg = (True, BLOCK_N, num_warps)
    else:
        if N >= 32768:
            num_warps = 32
        elif N >= 16384:
            num_warps = 16
        else:
            num_warps = 8
        cfg = (False, 4096, num_warps)
    _LAUNCH_CFG[N] = cfg
    return cfg


def {{ kernel_name }}(X: torch.Tensor) -> torch.Tensor:
    assert X.ndim == 2, "softmax expects 2D input"
    M, N = X.shape
    Y = torch.empty_like(X)

    cfg = _LAUNCH_CFG.get(N)
    if cfg is None:
        cfg = _softmax_cfg(N)
    is_simple, block, num_warps = cfg

    # Contiguous fast path: strides are exactly (N, 1) and Y (empty_like of a
    # contiguous X) matches — derive offsets from N inside the kernel and skip
    # all 4 stride args + M.
    if X.is_contiguous():
        if is_simple:
            {{ kernel_name }}_simple_c_kernel[(M,)](
                X, Y, N,
                BLOCK_N=block,
                num_warps=num_warps,
                num_stages=1,
            )
        else:
            {{ kernel_name }}_loop_c_kernel[(M,)](
                X, Y, N,
                TILE_N=block,
                num_warps=num_warps,
                num_stages=2,
            )
        return Y

    if is_simple:
        {{ kernel_name }}_simple_kernel[(M,)](
            X, Y,
            M, N,
            X.stride(0), X.stride(1),
            Y.stride(0), Y.stride(1),
            BLOCK_N=block,
            num_warps=num_warps,
            num_stages=1,
        )
    else:
        {{ kernel_name }}_loop_kernel[(M,)](
            X, Y,
            M, N,
            X.stride(0), X.stride(1),
            Y.stride(0), Y.stride(1),
            TILE_N=block,
            num_warps=num_warps,
            num_stages=2,
        )
    return Y
