def {{ kernel_name }}_kernel(
    X_ptr, A_ptr, B_ptr,
    M, N_a, N_total,
    stride_xm, stride_xn,
    stride_am, stride_an,
    stride_bm, stride_bn,
    BLOCK_M: tl.constexpr,
    BLOCK_N: tl.constexpr,
