    """Split X along axis=1 at position split_at."""
    assert X.ndim == 2
    M, N = X.shape
    assert 0 < split_at < N
    A = torch.empty((M, split_at), device=X.device, dtype=X.dtype)
    B = torch.empty((M, N - split_at), device=X.device, dtype=X.dtype)

    BLOCK_M = 32
    BLOCK_N = 128
    grid = (triton.cdiv(M, BLOCK_M), triton.cdiv(N, BLOCK_N))

    {{ kernel_name }}_kernel[grid](
        X, A, B,
        M, split_at, N,
        X.stride(0), X.stride(1),
        A.stride(0), A.stride(1),
        B.stride(0), B.stride(1),
        BLOCK_M=BLOCK_M, BLOCK_N=BLOCK_N,
    )
