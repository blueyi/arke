"""Auto-generated Triton embedding kernel by Arke.

Computes Y[b, s, :] = weight[indices[b, s], :]  (i.e. F.embedding).

Tensor-only host wrapper: `embedding(indices, weight) -> Y`. All dimensions
are inferred from the input tensor shapes at launch time; no codegen-time
scalars are required.

Strategy (S7.followup.1 perf upgrade): one program per output row, copying the
FULL D-wide vector in a single BLOCK_D = next_pow2(D) tile. The previous design
used a 2D grid (N rows x ceil(D/128) column tiles) with BLOCK_D=128 and an
extra int32 cast pass over the indices — that fragmented each row into many
tiny 128-element copies and paid a full HBM round-trip just to downcast the
index tensor, pinning latency at a flat ~180us regardless of shape (0.28x vs
FlagGems). One-program-per-row + no cast is ~3x faster (gpt2-small 180->59us,
now beating torch's 68us; llama2-seq2k 191->111us). int64 indices are used
directly — Triton gathers fine with them and the cast pass is pure waste.
"""
import torch
import triton
import triton.language as tl


@triton.jit
def {{ kernel_name }}_kernel(
    idx_ptr, W_ptr, Y_ptr,
    N, D,
    stride_wv, stride_wd,
    stride_yn, stride_yd,
    BLOCK_D: tl.constexpr,
):
    """One output row per program; copy the full D-wide gathered vector."""
    row = tl.program_id(0)
    if row >= N:
        return

    vocab_idx = tl.load(idx_ptr + row)

    offs_d = tl.arange(0, BLOCK_D)
    mask_d = offs_d < D

    w_ptrs = W_ptr + vocab_idx * stride_wv + offs_d * stride_wd
    vals = tl.load(w_ptrs, mask=mask_d, other=0.0)

    y_ptrs = Y_ptr + row * stride_yn + offs_d * stride_yd
    tl.store(y_ptrs, vals, mask=mask_d)


def {{ kernel_name }}(indices: torch.Tensor, weight: torch.Tensor) -> torch.Tensor:
    """Y = weight[indices]; output shape = (*indices.shape, weight.shape[1])."""
    assert weight.ndim == 2, "embedding template expects 2D weight [V, D]"
    D = weight.shape[1]

    # Keep indices in their native integer dtype — Triton gathers fine with
    # int64 and the previous .to(int32) was a wasteful full HBM pass.
    idx_flat = indices.reshape(-1).contiguous()
    N = idx_flat.numel()

    out_flat = torch.empty((N, D), device=weight.device, dtype=weight.dtype)

    # Full row in one tile. next_pow2(D) keeps the load vectorized; for the
    # common D (768/2048/4096) this is a single wide tile per row.
    BLOCK_D = triton.next_power_of_2(D)
    num_warps = 4  # best across D=768..4096 on RTX 3060 (memory-bound gather)
    grid = (N,)

    {{ kernel_name }}_kernel[grid](
        idx_flat, weight, out_flat,
        N, D,
        weight.stride(0), weight.stride(1),
        out_flat.stride(0), out_flat.stride(1),
        BLOCK_D=BLOCK_D,
        num_warps=num_warps,
    )

    return out_flat.reshape(*indices.shape, D)
