// Arke Language Grammar v0.2.0
// Lark EBNF Grammar — parses .ak files into AST

start: (import_stmt | kernel_def | strategy_def)*

// ─── Import ───
import_stmt: "import" STRING "as" IDENT ";"

// ─── Kernel Definition ───
kernel_def: "kernel" IDENT "(" param_list? ")" "->" tensor_type "{" kernel_body "}"
param_list: param ("," param)*
param: IDENT ":" tensor_type

tensor_type: "Tensor" "<" "[" dim_list "]" "," scalar_type ("," layout)? ">"
dim_list: INT ("," INT)*
scalar_type: SCALAR_TYPE
SCALAR_TYPE: "f16" | "f32" | "f64" | "bf16"
           | "i8" | "i16" | "i32" | "i64"
           | "u8" | "u16" | "u32" | "u64"
           | "bool" | "index"
layout: LAYOUT
LAYOUT: "row_major" | "col_major"

kernel_body: (let_stmt | return_stmt)+
let_stmt: "let" IDENT "=" op_call ";"
return_stmt: "return" IDENT ";"

op_call: IDENT "(" arg_list? ")"
arg_list: arg ("," arg)*
arg: IDENT "=" IDENT    -> named_arg
   | IDENT              -> positional_arg

// ─── Strategy Definition ───
strategy_def: "strategy" IDENT "for" "target" "(" STRING ")" "{" strategy_body "}"
strategy_body: strategy_stmt*
strategy_stmt: strategy_action annotation? ";"?
strategy_action: IDENT "(" strategy_args ")"
strategy_args: strategy_kwarg ("," strategy_kwarg)*
strategy_kwarg: IDENT "=" strategy_value
strategy_value: STRING
              | INT
              | FLOAT
              | "true"          -> bool_true
              | "false"         -> bool_false
              | array
              | map
              | IDENT           -> ident_value

array: "[" (strategy_value ("," strategy_value)*)? "]"
map: "{" (map_entry ("," map_entry)*)? "}"
map_entry: (IDENT | STRING) ":" strategy_value

annotation: "@" IDENT "(" STRING ")"

// ─── Tokens ───
IDENT: /[a-zA-Z_][a-zA-Z0-9_]*/
INT: /0[xX][0-9a-fA-F]+/ | /[0-9]+/
FLOAT: /[0-9]+\.[0-9]*([eE][+-]?[0-9]+)?/ | /[0-9]+[eE][+-]?[0-9]+/
STRING: /"[^"]*"/ | /'[^']*'/

// ─── Whitespace & Comments ───
COMMENT: /\/\/[^\n]*/
BLOCK_COMMENT: /\/\*[\s\S]*?\*\//

%ignore /\s+/
%ignore COMMENT
%ignore BLOCK_COMMENT
